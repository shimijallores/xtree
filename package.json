{
  "name": "xtree-ai",
  "version": "0.1.0",
  "description": "UML-driven code comprehension engine for Vibe Coders",
  "type": "module",
  "license": "MIT",
  "author": "shimijallores",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimijallores/xtree.git"
  },
  "homepage": "https://github.com/shimijallores/xtree#readme",
  "bugs": {
    "url": "https://github.com/shimijallores/xtree/issues"
  },
  "keywords": [
    "uml",
    "code-comprehension",
    "ast",
    "typescript",
    "ollama",
    "local-ai",
    "visualization",
    "call-graph",
    "vibe-coding"
  ],
  "bin": {
    "xtree": "./bin/xtree.js",
    "xtree-ai": "./bin/xtree.js"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "files": [
    "bin",
    "server/dist",
    "web/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "scripts": {
    "build:web": "bun run --filter xtree-web build",
    "build:server": "bun run --filter xtree-server build",
    "build": "bun run build:web && bun run build:server",
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter xtree-web dev",
    "dev:server": "bun run --filter xtree-server dev",
    "test": "bun run --filter xtree-server test",
    "typecheck": "bun run --filter '*' typecheck",
    "start": "bun bin/xtree.js start",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build"
  }
}
